# PostgreSQL (required)
DATABASE_URL=postgresql+psycopg://paradox:change-me@localhost:5432/paradox

# Authentication (set a fresh random value before deployment)
SECRET_KEY=replace-with-a-long-random-secret

# Optional test database; point this at a separate disposable PostgreSQL DB
# before running backend tests.
TEST_DATABASE_URL=postgresql+psycopg://paradox:change-me@localhost:5432/paradox_test

# Optional PostgreSQL connection tuning
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=1800

# Optional service configuration
LOG_LEVEL=INFO
LOG_DIR=backend/logs
LOG_SLOW_REQUEST_MS=1000
